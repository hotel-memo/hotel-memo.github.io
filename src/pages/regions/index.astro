---
import { getEntry, render } from "astro:content"
import Base from "../../layouts/Base.astro"
import { extractH1 } from "../../lib/memo"

const entry = await getEntry("pages", "regions")
if (!entry) throw new Error("regions の index ページが見つかりません")
const { Content } = await render(entry)
const title = entry.data.title ?? extractH1(entry.body) ?? "ワークチェアがあるホテル"
---

<Base title={title} ogImage="/og/pages/regions.png">
  <nav class="breadcrumb">
    <a href="/">Hotel × Deskwork</a>
  </nav>
  <Content />
</Base>
