---
import { getCollection, render } from "astro:content"
import Base from "../../layouts/Base.astro"
import {
  byStayedAtDesc,
  chainNameMap,
  extractH1,
  memoPathInfo,
} from "../../lib/memo"

export async function getStaticPaths() {
  const memos = await getCollection("memos")
  const hotels = await getCollection("hotels")

  const memoPaths = memos.map((entry) => ({
    params: { slug: entry.id.replace(/^memos\//, "") },
    props: { entry, kind: "memo" as const },
  }))

  const hotelPaths = hotels.map((entry) => ({
    params: { slug: entry.id.replace(/^memos\//, "") },
    props: { entry, kind: "hotel" as const },
  }))

  return [...memoPaths, ...hotelPaths]
}

const { entry, kind } = Astro.props
const { Content } = await render(entry)

const description =
  kind === "memo"
    ? `★${(entry as any).data.rating}/5 ${(entry as any).data.title}`
    : undefined

const memoPath = kind === "memo" ? memoPathInfo(entry.id) : null
const fallbackTitle =
  kind === "hotel" ? extractH1(entry.body) ?? entry.id : entry.id
const title = entry.data.title ?? fallbackTitle

const officialHostname =
  kind === "hotel" && (entry as any).data.official
    ? new URL((entry as any).data.official).hostname
    : ""

const hotelChainKey = kind === "hotel" ? entry.id.split("/")[1] : null
const hotelChainName = hotelChainKey
  ? (chainNameMap[hotelChainKey] ?? hotelChainKey)
  : null

const hotelMemos =
  kind === "hotel"
    ? (await getCollection("memos"))
        .filter((m) => m.id.startsWith("memos/"))
        .filter((m) => m.id.startsWith(entry.id + "/"))
        .sort(byStayedAtDesc)
    : []

let parentHotelName: string | null = null
let parentHotelHref: string | null = null
const SIBLING_LIMIT = 6
let siblingMemos: Awaited<ReturnType<typeof getCollection<"memos">>> = []
let siblingTotal = 0
if (kind === "memo" && memoPath) {
  const parentId = `memos/${memoPath.chain}/${memoPath.hotel}`
  const parentEntry = (await getCollection("hotels")).find(
    (h) => h.id === parentId,
  )
  parentHotelName =
    parentEntry?.data.title ??
    (parentEntry ? (extractH1(parentEntry.body) ?? memoPath.hotel) : memoPath.hotel)
  parentHotelHref = `/${parentId}/`

  const all = (await getCollection("memos"))
    .filter((m) => !m.data.draft)
    .filter((m) => m.id.startsWith(parentId + "/"))
    .filter((m) => m.id !== entry.id)
  siblingTotal = all.length
  siblingMemos = all
    .sort((a, b) => {
      if (b.data.rating !== a.data.rating) return b.data.rating - a.data.rating
      const ad = a.data.stayed_at?.getTime() ?? 0
      const bd = b.data.stayed_at?.getTime() ?? 0
      return bd - ad
    })
    .slice(0, SIBLING_LIMIT)
}

const formatYM = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, "0")}`

const formatYMD = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, "0")}.${String(d.getDate()).padStart(2, "0")}`

let stayJumps: { id: string; label: string; date?: string }[] = []
let totalStays = 1
if (kind === "memo") {
  const counts = new Map<string, number>()
  const lines = entry.body?.split("\n") ?? []
  const raw: { name: string; date?: string }[] = []
  for (let i = 0; i < lines.length; i++) {
    const m = lines[i].match(/^##\s+(\d+号室)\s*$/)
    if (!m) continue
    const name = m[1]
    let date: string | undefined
    for (let j = i + 1; j < Math.min(i + 5, lines.length); j++) {
      const t = lines[j].trim()
      if (!t) continue
      const d = t.match(/(\d{4})[.\-/年](\d{1,2})[.\-/月]?(\d{1,2})?/)
      if (d) {
        const yyyy = d[1]
        const mm = d[2].padStart(2, "0")
        date = d[3] ? `${yyyy}.${mm}.${d[3].padStart(2, "0")}` : `${yyyy}.${mm}`
      }
      break
    }
    raw.push({ name, date })
  }
  stayJumps = raw.map(({ name, date }) => {
    const n = (counts.get(name) ?? 0) + 1
    counts.set(name, n)
    const id = n === 1 ? name : `${name}-${n}`
    const label = date ? `${name} · ${date}` : name
    return { id, label, date }
  })
  totalStays = Math.max(stayJumps.length, 1)
}

const ogImage =
  kind === "memo"
    ? `/og/memos/${entry.id.replace(/^memos\//, "")}.png`
    : `/og/hotels/${entry.id.replace(/^memos\//, "")}.png`
---

<Base title={title} description={description} ogImage={ogImage}>
  {
    kind === "memo" && (
      <>
        <p class="memo-kicker">
          {parentHotelHref ? (
            <a href={parentHotelHref}>← {parentHotelName}</a>
          ) : (
            "宿泊メモ"
          )}
        </p>
        <h1>{title}</h1>

        <div class="memo-hero">
          <div class="rating">
            <span class="stars">
              <span class="on">{"★".repeat((entry as any).data.rating)}</span>
              <span class="off">
                {"☆".repeat(5 - (entry as any).data.rating)}
              </span>
            </span>
            <span class="score">{(entry as any).data.rating} / 5</span>
          </div>
          {(entry as any).data.rating_note && (
            <div
              class="rating-note"
              set:html={(entry as any).data.rating_note.replace(
                /★+/g,
                (m: string) => `<span class="s">${m}</span>`,
              )}
            />
          )}
          <div class="meta">
            <span class="badge-stayed">実宿泊</span>
            {(entry as any).data.stayed_at && (
              <span>
                <span class="label">{totalStays > 1 ? "最新" : "宿泊"}</span>
                {formatYMD((entry as any).data.stayed_at)}
              </span>
            )}
            {totalStays > 1 && (
              <span>
                <span class="label">記録</span>
                {totalStays}回
              </span>
            )}
          </div>
        </div>

        {stayJumps.length > 1 && (
          <nav class="stay-jumps">
            <span class="label">宿泊履歴</span>
            <div class="chips">
              {stayJumps.map((j) => (
                <a href={`#${j.id}`}>{j.label}</a>
              ))}
            </div>
          </nav>
        )}
      </>
    )
  }

  {
    kind === "hotel" && (
      <>
        <p class="hotel-kicker">
          {hotelChainKey ? (
            <a href={`/memos/${hotelChainKey}/`}>← {hotelChainName}</a>
          ) : (
            "ホテル"
          )}
        </p>
        <h1>{title}</h1>
        <div class="hotel-meta">
          {(entry as any).data.chain && (
            <span>
              <span class="label">チェーン</span>
              {(entry as any).data.chain}
            </span>
          )}
          {(entry as any).data.official && (
            <span>
              <span class="label">公式</span>
              <a
                href={(entry as any).data.official}
                target="_blank"
                rel="noopener"
              >
                {officialHostname} ↗
              </a>
            </span>
          )}
        </div>
      </>
    )
  }

  {kind === "memo" ? (
    <div class="memo">
      <Content />
    </div>
  ) : (
    <Content />
  )}

  {kind === "memo" && siblingTotal > 0 && (
    <section class="sibling-memos">
      <span class="section-label">
        {parentHotelName} の他のメモ（{siblingTotal}件）
      </span>
      <ul>
        {siblingMemos.map((m) => (
          <li>
            {m.data.cover ? (
              <img class="thumb" src={m.data.cover} alt="" />
            ) : (
              <span class="thumb" aria-hidden="true"></span>
            )}
            <div class="meta">
              <span class="stars">
                <span class="on">{"★".repeat(m.data.rating)}</span><span class="off">{"☆".repeat(5 - m.data.rating)}</span>
              </span>
              <span class="date">
                {m.data.stayed_at ? formatYM(m.data.stayed_at) : "—"}
              </span>
            </div>
            <span class="title">
              <a href={`/memos/${m.id.replace(/^memos\//, "")}/`}>{m.data.title}</a>
            </span>
          </li>
        ))}
      </ul>
      {siblingTotal > SIBLING_LIMIT && parentHotelHref && (
        <p class="sibling-memos__more">
          <a href={parentHotelHref}>+ {siblingTotal - SIBLING_LIMIT}件 →</a>
        </p>
      )}
    </section>
  )}

  {kind === "memo" && (
    <dialog class="lightbox" aria-label="拡大表示">
      <button class="lightbox__close" type="button" aria-label="閉じる">×</button>
      <button class="lightbox__prev" type="button" aria-label="前の写真">‹</button>
      <img class="lightbox__img" alt="" />
      <button class="lightbox__next" type="button" aria-label="次の写真">›</button>
    </dialog>
    <script>
      const memo = document.querySelector(".memo")
      const dialog = document.querySelector(".lightbox") as HTMLDialogElement | null
      const dialogImg = dialog?.querySelector(".lightbox__img") as HTMLImageElement | null
      const prevBtn = dialog?.querySelector(".lightbox__prev") as HTMLButtonElement | null
      const nextBtn = dialog?.querySelector(".lightbox__next") as HTMLButtonElement | null
      const closeBtn = dialog?.querySelector(".lightbox__close") as HTMLButtonElement | null
      if (memo && dialog && dialogImg && prevBtn && nextBtn && closeBtn) {
        const imgs = Array.from(memo.querySelectorAll("p > img, .memo-gallery > img")) as HTMLImageElement[]
        let index = 0
        const show = (i: number) => {
          index = (i + imgs.length) % imgs.length
          dialogImg.src = imgs[index].src
        }
        imgs.forEach((img, i) => {
          img.style.cursor = "zoom-in"
          img.addEventListener("click", () => {
            show(i)
            dialog.showModal()
          })
        })
        prevBtn.addEventListener("click", (e) => {
          e.stopPropagation()
          show(index - 1)
        })
        nextBtn.addEventListener("click", (e) => {
          e.stopPropagation()
          show(index + 1)
        })
        closeBtn.addEventListener("click", () => dialog.close())
        dialog.addEventListener("click", (e) => {
          if (e.target === dialog) dialog.close()
        })
        dialog.addEventListener("keydown", (e) => {
          if (e.key === "ArrowLeft") show(index - 1)
          else if (e.key === "ArrowRight") show(index + 1)
        })
      }
    </script>
  )}

  {
    kind === "hotel" && hotelMemos.length > 0 && (
      <section>
        <span class="section-label">宿泊メモ（{hotelMemos.length}件）</span>
        <ul class="memo-list">
          {hotelMemos.map((m) => (
            <li>
              {m.data.cover ? (
                <img class="thumb" src={m.data.cover} alt="" />
              ) : (
                <span class="thumb" aria-hidden="true" />
              )}
              <div class="meta">
                <span class="stars">
                  <span class="on">{"★".repeat(m.data.rating)}</span>
                  <span class="off">{"☆".repeat(5 - m.data.rating)}</span>
                </span>
                <span class="date">
                  {m.data.stayed_at ? formatYM(m.data.stayed_at) : "—"}
                </span>
              </div>
              <span class="title">
                <a href={`/memos/${m.id.replace(/^memos\//, "")}/`}>
                  {m.data.title}
                </a>
              </span>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Base>
