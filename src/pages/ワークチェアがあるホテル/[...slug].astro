---
import { getCollection, render } from "astro:content"
import Base from "../../layouts/Base.astro"
import { extractH1 } from "../../lib/memo"

export async function getStaticPaths() {
  const entries = await getCollection("workchair")
  return entries
    .filter((entry) => !entry.id.endsWith("/index"))
    .map((entry) => ({
      params: {
        slug: entry.id
          .replace(/^ワークチェアがあるホテル\//, "")
          .replace(/\.md$/, ""),
      },
      props: { entry },
    }))
}

const { entry } = Astro.props
const { Content } = await render(entry)
const title = entry.data.title ?? extractH1(entry.body) ?? "ワークチェアがあるホテル"
const isIndex = false
const ogImage = `/og/workchair/${entry.id.replace(/^ワークチェアがあるホテル\//, "")}.png`
---

<Base title={title} ogImage={ogImage}>
  <nav class="breadcrumb">
    <a href="/">Hotel Memo</a>
    {!isIndex && (
      <>
        {" "}/ <a href="/ワークチェアがあるホテル/">ワークチェアがあるホテル</a>
      </>
    )}
  </nav>
  <h1>{title}</h1>
  <Content />
</Base>
