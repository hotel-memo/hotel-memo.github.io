---
import { getEntry, render } from "astro:content"
import Base from "../layouts/Base.astro"
import { extractH1 } from "../lib/memo"

const entry = await getEntry("pages", "パソコン作業の快適さ評価")
if (!entry) throw new Error("パソコン作業の快適さ評価 が見つかりません")
const { Content } = await render(entry)
const title = entry.data.title ?? extractH1(entry.body) ?? "パソコン作業の快適さ評価"
---

<Base title={title} ogImage="/og/pages/パソコン作業の快適さ評価.png">
  <nav class="breadcrumb">
    <a href="/">Hotel Memo</a>
  </nav>
  <h1>{title}</h1>
  <Content />
</Base>
