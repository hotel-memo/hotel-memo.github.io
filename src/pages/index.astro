---
import { getCollection } from "astro:content"
import Base from "../layouts/Base.astro"
import {
  byRatingDesc,
  byStayedAtDesc,
  chainNameMap,
  extractH1,
  memoSlug,
} from "../lib/memo"

const memos = (await getCollection("memos"))
  .filter((m) => !m.data.draft)
  .filter((m) => m.id.startsWith("memos/"))
const regions = (await getCollection("regions"))
  .filter((r) => !r.data.draft)
  .filter((r) => r.id.startsWith("regions/"))
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99))

const hotelEntries = (await getCollection("hotels"))
  .filter((h) => !h.data.draft)
  .filter((h) => h.id.startsWith("memos/"))
const hotels = hotelEntries
  .map((h) => {
    const slug = h.id
    const name = h.data.title ?? extractH1(h.body) ?? slug
    const chain = slug.split("/")[1] ?? "other"
    return { slug, name, chain }
  })
  .sort((a, b) => a.name.localeCompare(b.name, "ja"))

const hotelsByChain = new Map<string, typeof hotels>()
for (const h of hotels) {
  if (!hotelsByChain.has(h.chain)) hotelsByChain.set(h.chain, [])
  hotelsByChain.get(h.chain)!.push(h)
}
const chainGroups = [...hotelsByChain.entries()]
  .map(([key, items]) => ({
    key,
    name: chainNameMap[key] ?? key,
    items,
  }))
  .sort(
    (a, b) => b.items.length - a.items.length || a.key.localeCompare(b.key),
  )

const formatYM = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, "0")}`

const ranked = [...memos].sort(byRatingDesc)
const recent = memos
  .filter((m) => m.data.stayed_at)
  .sort(byStayedAtDesc)
  .slice(0, 9)

const featuredCandidates = memos.filter((m) => m.data.cover)
const featuredPool = featuredCandidates.length ? featuredCandidates : ranked
const today = new Date()
const dateSeed =
  today.getUTCFullYear() * 10000 +
  (today.getUTCMonth() + 1) * 100 +
  today.getUTCDate()
const featured = featuredPool.length
  ? featuredPool[dateSeed % featuredPool.length]
  : null

const regionNameMap: Record<string, string> = {
  hokkaido: "北海道",
  tohoku: "東北",
  kanto: "関東",
  chubu: "中部",
  kansai: "関西",
  "chugoku-shikoku": "中国・四国",
  "kyushu-okinawa": "九州・沖縄",
}
const regionLinks = regions.map((r) => {
  const slug = r.id.replace(/^regions\//, "")
  return { slug, name: regionNameMap[slug] ?? slug }
})
---

<Base
  title="Hotel × Deskwork"
  description="ホテルの部屋で快適に仕事ができるかを 5 段階で記録。ワークチェアの有無、デスクの広さ、Wi-Fi などを評価。"
  mainClass="home"
>
  <section class="hero">
    <div>
      <h1 class="hero__title">ホテルの部屋で快適に仕事を</h1>
      <p class="hero__lede">
        ホテルサイトに掲載されている客室写真からワークチェアがありそうなホテルを推測した地域別リストと、実際に泊まった部屋でワークチェアやデスクの広さ、Wi-Fiなど、快適に仕事ができるかどうかを5段階で記録した宿泊メモです。
      </p>
    </div>

    {
      featured && (
        <a class="featured" href={`/${memoSlug(featured.id)}/`}>
          {featured.data.cover && <img src={featured.data.cover} alt="" />}
          <div class="featured__body">
            <div class="featured__kicker">ピックアップ</div>
            <div class="featured__title">{featured.data.title}</div>
            <span class="stars" aria-label={`★${featured.data.rating}`}>
              <span class="on">{"★".repeat(featured.data.rating)}</span>
              <span class="off">{"☆".repeat(5 - featured.data.rating)}</span>
            </span>
          </div>
        </a>
      )
    }
  </section>

  <section class="section">
    <span class="section-label">地域別ワークチェアがありそうなホテル</span>
    <div class="region-chips">
      {regionLinks.map((r) => <a href={`/regions/${r.slug}/`}>{r.name}</a>)}
    </div>
    <p class="region-note">
      各ホテルの公式サイトに掲載されている客室写真等から、ワークチェアがありそうに見えるホテルをまとめたものです。実際の配備状況は部屋タイプや時期により異なる可能性があり、ワークチェアの有無を保証するものではありません。
    </p>
  </section>

  <div class="home-cols">
    <section>
      <span class="section-label">宿泊したホテル</span>
      <div class="chain-list">
        {
          chainGroups.map((g) => (
            <div class="chain-group">
              <div class="chain-head">
                <a href={`/memos/${g.key}/`}>{g.name}</a>
              </div>
              <ul class="chain-items">
                {g.items.map((h) => (
                  <li>
                    <a href={`/${h.slug}/`}>{h.name}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <section>
      <span class="section-label">最近の宿泊メモ</span>
      <ul class="recent-list recent-list--thumb">
        {
          recent.map((m) => (
            <li>
              {m.data.cover && (
                <img class="recent-thumb" src={m.data.cover} alt="" />
              )}
              <span class="recent-date">{formatYM(m.data.stayed_at!)}</span>
              <span class="recent-title">
                <a href={`/${memoSlug(m.id)}/`}>{m.data.title}</a>
              </span>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Base>
