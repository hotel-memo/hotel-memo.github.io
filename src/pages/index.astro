---
import { getCollection } from "astro:content"
import Base from "../layouts/Base.astro"
import { byRatingDesc, byStayedAtDesc, memoSlug } from "../lib/memo"

const memos = (await getCollection("memos")).filter((m) => !m.data.draft)
const regions = (await getCollection("regions"))
  .filter((r) => !r.data.draft)
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99))

const stars = (n: number) => "★".repeat(n) + "☆".repeat(5 - n)
const formatYM = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, "0")}`

const ranked = [...memos].sort(byRatingDesc).slice(0, 8)
const recent = memos
  .filter((m) => m.data.stayed_at)
  .sort(byStayedAtDesc)
  .slice(0, 8)

const regionNameMap: Record<string, string> = {
  hokkaido: "北海道",
  tohoku: "東北",
  kanto: "関東",
  chubu: "中部",
  kansai: "関西",
  "chugoku-shikoku": "中国・四国",
  "kyushu-okinawa": "九州・沖縄",
}
const regionLinks = regions.map((r) => {
  const slug = r.id.replace(/^regions\//, "")
  return { slug, name: regionNameMap[slug] ?? slug }
})
---

<Base
  title="Hotel × Deskwork"
  description="ホテルの部屋で快適に仕事ができるかを 5 段階で記録。ワークチェアの有無、デスクの広さ、Wi-Fi などを評価。"
>
  <div class="lede">
    <p>
      ワークチェアやデスクの広さ、Wi-Fi など、ホテルの部屋で快適に仕事ができるかどうかを 5 段階で記録しています。実際に泊まった記録と、客室写真からワークチェアがありそうなホテルを推測したリストです。
    </p>
  </div>
  <section class="section">
    <div class="section__head">
      <h2>地域から探す</h2>
      <a class="section__more" href="/regions/">一覧 →</a>
    </div>
    <div class="region-grid">
      {regionLinks.map((r) => <a href={`/regions/${r.slug}/`}>{r.name}</a>)}
    </div>
  </section>

  <section class="section">
    <div class="section__head">
      <h2>パソコン作業の快適さランキング</h2>
      <a class="section__more" href="/ratings/">全件 →</a>
    </div>
    <ul class="rank-list">
      {
        ranked.map((m) => (
          <li>
            <span class="stars" aria-label={`★${m.data.rating}`}>
              {stars(m.data.rating)}
            </span>
            <span class="rank-title">
              <a href={`/${memoSlug(m.id)}/`}>{m.data.title}</a>
            </span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section">
    <div class="section__head">
      <h2>最近の宿泊メモ</h2>
    </div>
    <ul class="recent-list">
      {
        recent.map((m) => (
          <li>
            <span class="recent-date">{formatYM(m.data.stayed_at!)}</span>
            <span class="recent-title">
              <a href={`/${memoSlug(m.id)}/`}>{m.data.title}</a>
            </span>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
